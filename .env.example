# Google Tag Manager container (loaded on every page)
NEXT_PUBLIC_GTM_ID=GTM-N5W9SZBX

# Optional GA4 Measurement ID (only if GA is NOT already configured inside GTM)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cloudflare Turnstile (contact form bot protection)
# Store keys WITHOUT the 0x prefix — the app prepends 0x when calling Cloudflare.
# Site key is public (browser). Secret key stays server-only — never expose it as NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Homestead District contact form endpoint (Webstix / Supabase form portal)
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://ywwxvriolxwuqcwjaluh.supabase.co/functions/v1/form-submit/059b0f3f-f905-4282-a89a-4ab70255c95c
