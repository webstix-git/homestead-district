# Optional analytics — thank-you conversion events fire when either is set.
# Google Tag Manager container (preferred if you manage tags in GTM)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Analytics 4 measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cloudflare Turnstile (contact form bot protection)
# Store keys WITHOUT the 0x prefix — the app prepends 0x when calling Cloudflare.
# Site key is public (browser). Secret key stays server-only — never expose it as NEXT_PUBLIC_*.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
